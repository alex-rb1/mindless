generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// models

model User {
  //Identity
  id Int @id @default(autoincrement())

  // User data
  name         String
  email        String @unique
  passwordHash String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
