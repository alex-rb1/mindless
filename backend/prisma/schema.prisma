generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// models

model User {
  //Identity
  id Int @id @default(autoincrement())

  // User data
  name         String
  email        String @unique
  passwordHash String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions   Session[]
  inboxItems InboxItem[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])
}

model InboxItem {
  id        Int       @id @default(autoincrement())
  title     String
  priority  Priority?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
